LATIHAN 2.2: UPDATE & DELETE
Instruksi:
Lakukan operasi UPDATE dan DELETE berdasarkan skenario berikut:
Skenario 1: Kenaikan Honor Instruktur
            -- Berikan kenaikan honor 10% untuk semua instruktur
            UPDATE instruktur 
            SET honor = honor * 1.1;
            
            -- Verifikasi hasil
            SELECT inisial, nama, honor FROM instruktur;
Skenario 2: Update Data Peserta
            -- Update kota peserta dengan id = 3 menjadi 'Bandung'
            UPDATE peserta 
            SET kota = 'Bandung' 
            WHERE id = 3;
            
            -- Update prestasi peserta dengan id = 7 menjadi 80
            UPDATE peserta 
            SET prestasi = 80 
            WHERE id = 7;
Skenario 3: Hapus Data
            -- Hapus peserta dengan id = 8 (Hana Pertiwi)
            DELETE FROM peserta 
            WHERE id = 8;
            
            -- Verifikasi
            SELECT * FROM peserta;
Skenario 4: Update Massal dengan Kondisi
            -- Tambahkan 50000 honor untuk instruktur dengan honor di bawah 500000
            UPDATE instruktur 
            SET honor = honor + 50000 
            WHERE honor < 500000;

LATIHAN 2.3: SELECT dengan WHERE & Filtering
Instruksi:
Buat query untuk menjawab pertanyaan berikut:
1. Tampilkan semua peserta dari Jakarta
            SELECT * FROM peserta 
            WHERE kota = 'Jakarta';
2. Tampilkan peserta wanita dengan prestasi di atas 85
            SELECT nama, kota, prestasi 
            FROM peserta 
            WHERE gender = 'P' AND prestasi > 85;
3. Tampilkan instruktur dengan honor antara 400000 dan 500000
            SELECT nama, honor 
            FROM instruktur 
            WHERE honor BETWEEN 400000 AND 500000;
4. Tampilkan peserta yang namanya diawali huruf 'A' atau 'B'
            SELECT nama, kota 
            FROM peserta 
            WHERE nama LIKE 'A%' OR nama LIKE 'B%';
5. Tampilkan peserta yang belum punya nomor HP
            SELECT nama, kota 
            FROM peserta 
            WHERE no_hp IS NULL;
6. Tampilkan topik dengan tingkat 'Dasar' atau 'Menengah'
            SELECT nama_topik, tingkat 
            FROM topik 
            WHERE tingkat IN ('Dasar', 'Menengah');
7. Tampilkan peserta dari Jakarta, Bandung, atau Surabaya, urutkan berdasarkan nama
            SELECT nama, kota, prestasi 
            FROM peserta 
            WHERE kota IN ('Jakarta', 'Bandung', 'Surabaya')
            ORDER BY nama ASC;
8. Hitung rata-rata prestasi peserta per kota
            SELECT kota, AVG(prestasi) AS rata_prestasi 
            FROM peserta 
            GROUP BY kota;
9. Tampilkan kota dengan jumlah peserta lebih dari 2
            SELECT kota, COUNT(*) AS jumlah_peserta 
            FROM peserta 
            GROUP BY kota 
            HAVING COUNT(*) > 2;
10. Tampilkan instruktur dengan honor di atas rata-rata
            SELECT nama, honor 
            FROM instruktur 
            WHERE honor > (SELECT AVG(honor) FROM instruktur);
